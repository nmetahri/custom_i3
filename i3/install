#!/bin/bash

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to display help
show_help() {
    cat << EOF
${BLUE}i3 Environment Setup and Configuration Installer${NC}

${YELLOW}Usage:${NC}
    sudo ./install [OPTIONS]

${YELLOW}Options:${NC}
    (no arguments)      Full installation: install packages, build i3blocks, setup config
    --update            Update only the i3 configuration files (no package installation)
    --update-config     Same as --update
    -h, --help          Show this help message

${YELLOW}Examples:${NC}
    sudo ./install                  # Fresh installation
    sudo ./install --update         # Update existing configuration
    sudo ./install --help           # Show this help

${YELLOW}Notes:${NC}
    - This script must be run with sudo
    - Only works on Debian/Ubuntu-based systems
    - The --update option is useful when pulling updates from the repository
EOF
}

if [ -z "$SUDO_USER" ]; then
    echo -e "${RED}This script must be run using sudo.${NC}"
    exit 1
fi

# Parse command line arguments
UPDATE_MODE=false
while [[ $# -gt 0 ]]; do
    case $1 in
        --update|--update-config)
            UPDATE_MODE=true
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Exit immediately if a command exits with a non-zero status (after argument parsing).
set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
PACKAGES=(
    "xorg" "i3-wm" "i3lock-fancy" "i3status" "dmenu" "fonts-hack-nerd"
    "feh" "flameshot" "bash-completion" "autoconf" "automake" "pkg-config"
    "light" "acpi" "blueman" "alsa-utils" "gnome-flashback" "zenity"
    "numlockx" "playerctl" "alacritty" "build-essential"
    "gdm3" "dbus-x11" "gnome-settings-daemon"
    "dex" "xss-lock" "network-manager-gnome" "pulseaudio-utils"
    "gnome-power-manager" "git" "gnome-session" "gnome-keyring"
)

# Safer way to get user's home directory
SUDO_USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
I3_CONFIG_PATH="$SUDO_USER_HOME/.config/i3/"
ALACRITTY_CONFIG_PATH="$SUDO_USER_HOME/.config/alacritty/"
# Set default display manager to gdm3
display_manager="gdm3"

# Function to setup i3 configuration
setup_i3_config() {
    echo -e "${BLUE}Setting up i3 configuration...${NC}"
    if [ -d "${SCRIPT_DIR}/configuration" ]; then
        mkdir -p "${I3_CONFIG_PATH}"
        cp -r "${SCRIPT_DIR}/configuration/"* "${I3_CONFIG_PATH}"
        echo -e "${GREEN}✓ i3 configuration copied${NC}"
    else
        echo -e "${RED}Configuration directory not found at ${SCRIPT_DIR}/configuration. Skipping configuration copy.${NC}"
        return 1
    fi
}

# Function to setup i3blocks
setup_i3blocks() {
    echo -e "${BLUE}Setting up i3blocks configuration...${NC}"
    if [ -d "${SCRIPT_DIR}/i3blocks" ]; then
        mkdir -p "${SUDO_USER_HOME}/.config/"
        cp -r "${SCRIPT_DIR}/i3blocks" "${SUDO_USER_HOME}/.config/"
        echo -e "${GREEN}✓ i3blocks configuration copied${NC}"
    else
        echo -e "${RED}i3blocks directory not found at ${SCRIPT_DIR}/i3blocks. Skipping i3blocks configuration copy.${NC}"
        return 1
    fi
}

# Function to setup alacritty
setup_alacritty() {
    echo -e "${BLUE}Setting up Alacritty configuration...${NC}"
    if [ -d "${SCRIPT_DIR}/../alacritty" ]; then
        mkdir -p "${ALACRITTY_CONFIG_PATH}"
        cp "${SCRIPT_DIR}/../alacritty/alacritty.yml" "${ALACRITTY_CONFIG_PATH}"
        echo -e "${GREEN}✓ Alacritty configuration copied${NC}"
    else
        echo -e "${YELLOW}⚠ Alacritty configuration directory not found. Skipping.${NC}"
        return 0
    fi
}

# Function to fix ownership
fix_ownership() {
    echo -e "${BLUE}Changing ownership of the configuration files to $SUDO_USER...${NC}"
    chown -R "$SUDO_USER:$SUDO_USER" "${I3_CONFIG_PATH}"
    chown -R "$SUDO_USER:$SUDO_USER" "${SUDO_USER_HOME}/.config/i3blocks" 2>/dev/null || true
    chown -R "$SUDO_USER:$SUDO_USER" "${ALACRITTY_CONFIG_PATH}" 2>/dev/null || true
}

# --- UPDATE MODE ---
if [ "$UPDATE_MODE" = true ]; then
    echo -e "${YELLOW}========================================${NC}"
    echo -e "${YELLOW}| Updating i3 configuration...${NC}"
    echo -e "${YELLOW}========================================${NC}"

    if [ ! -d "${I3_CONFIG_PATH}" ]; then
        echo -e "${RED}Error: i3 is not installed in $I3_CONFIG_PATH${NC}"
        echo -e "${YELLOW}Please run a fresh installation first: sudo ./install${NC}"
        exit 1
    fi

    setup_i3_config
    setup_i3blocks
    setup_alacritty
    fix_ownership

    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}✓ i3 configuration updated successfully!${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo -e "${BLUE}Reload your i3 config with: \$mod+shift+c${NC}"
    exit 0
fi

# --- FULL INSTALLATION MODE ---

install_packages() {
    echo -e "${BLUE}Updating package lists...${NC}"
    apt-get update

    echo -e "${BLUE}Installing necessary packages...${NC}"
    for package in "${PACKAGES[@]}"
    do
        apt-get install -y "$package"
    done
    echo -e "${GREEN}✓ All packages installed${NC}"
}

# --- Distro validation ---
if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS=$NAME
    if [[ "$OS" != "Ubuntu" && "$OS" != "Debian GNU/Linux" ]]; then
        echo -e "${RED}This script is only compatible with Debian or Ubuntu.${NC}"
        echo "Detected OS: $OS"
        exit 1
    fi
else
    echo -e "${RED}Cannot determine the Linux distribution.${NC}"
    exit 1
fi
# --- Validation end ---

echo -e "${BLUE}======================================${NC}"
echo -e "${BLUE}| Let's setup your i3 environment... |${NC}"
echo -e "${BLUE}======================================${NC}"

echo -e "${YELLOW}The following packages will be installed:${NC}"
for package in "${PACKAGES[@]}"; do
    echo -e "  ${BLUE}-${NC} $package"
done

echo -n "Do you agree to install these packages? (y/n): " && read -r confirmation
if [[ "$confirmation" != "y" ]]; then
    echo -e "${YELLOW}Installation aborted.${NC}"
    exit 1
fi

install_packages

echo -e "${GREEN}======================================================================================${NC}"
echo -e "${GREEN}| Installation completed successfully! Let's start configuring your i3 environment... |${NC}"
echo -e "${GREEN}=======================================================================================${NC}"

# --- Build in Temporary Directory ---
echo -e "${BLUE}Creating temporary build directory...${NC}"
BUILD_DIR=$(mktemp -d)

# Set a trap to clean up the build directory on exit
trap 'echo -e "${BLUE}Cleaning up temp directory...${NC}"; rm -rf "$BUILD_DIR"' EXIT

cd "$BUILD_DIR"

# i3 blocks
echo -e "${BLUE}Installing i3 blocks (git version)...${NC}"
git clone https://github.com/vivien/i3blocks
cd i3blocks
./autogen.sh
./configure
make
make install # No sudo needed, already root
echo -e "${GREEN}✓ i3blocks installed${NC}"
cd ..

# Gnome + I3 integration
echo -e "${BLUE}Configuring Gnome 3 sessions to work with i3...${NC}"
git clone https://github.com/i3-gnome/i3-gnome.git i3-gnome
cd i3-gnome
make install # No sudo needed, already root
echo -e "${GREEN}✓ i3-gnome integration configured${NC}"
cd ..

# Return to script dir (or /) before temp dir is deleted
cd /
# --- End of Build Section ---

# Disable gnome flashback desktop
echo -e "${BLUE}Configuring Gnome settings...${NC}"
sudo -u "$SUDO_USER" dbus-launch gsettings set org.gnome.gnome-flashback desktop false

# Fix hidden system tray icons
sudo -u "$SUDO_USER" dbus-launch gsettings set org.gnome.gnome-flashback status-notifier-watcher false

# Setup I3 and i3blocks configuration
setup_i3_config
setup_i3blocks
setup_alacritty

# Change ownership to the original user
fix_ownership

# Enable and start the display manager
echo -e "${BLUE}Enabling $display_manager service...${NC}"
systemctl enable display-manager.service
systemctl start display-manager.service

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}✓ i3 environment setup completed!${NC}"
echo -e "${GREEN}========================================${NC}"
echo -e "${YELLOW}Next steps:${NC}"
echo -e "  1. Reboot your system"
echo -e "  2. Select ${BLUE}i3+gnome${NC} session at login screen"
echo -e "  3. Login and enjoy!"
