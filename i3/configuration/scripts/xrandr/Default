#!/bin/bash
# Auto-configures all connected displays side-by-side.

CONNECTED_MONITORS=$(xrandr -q | grep " connected" | awk '{print $1}')

if [ -z "$CONNECTED_MONITORS" ]; then
    exit 1
fi

XR_CMD="xrandr"
PREV_MONITOR=""

for MONITOR in $CONNECTED_MONITORS; do
    if [ -z "$PREV_MONITOR" ]; then
        # First monitor, set as primary
        XR_CMD="$XR_CMD --output $MONITOR --auto --primary"
    else
        # Subsequent monitors, place to the right
        XR_CMD="$XR_CMD --output $MONITOR --auto --right-of $PREV_MONITOR"
    fi
    PREV_MONITOR=$MONITOR
done

eval "$XR_CMD"
