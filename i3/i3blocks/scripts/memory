#!/usr/bin/env sh
# Memory block for i3blocks
# Uses MemAvailable from /proc/meminfo which is the most accurate measure
# of available memory (accounts for page cache reclaimable by kernel).
TYPE="${BLOCK_INSTANCE:-mem}"
PERCENT="${PERCENT:-true}"
awk -v type="$TYPE" -v percent="$PERCENT" -v label="$LABEL" '
/^MemTotal:/     { mem_total=$2 }
/^MemAvailable:/ { mem_available=$2 }
/^SwapTotal:/    { swap_total=$2 }
/^SwapFree:/     { swap_free=$2 }
END {
    if (type == "swap") {
        free  = swap_free  / 1024 / 1024
        used  = (swap_total - swap_free) / 1024 / 1024
        total = swap_total / 1024 / 1024
    } else {
        # MemAvailable is what the kernel reports as truly usable
        free  = mem_available / 1024 / 1024
        used  = (mem_total - mem_available) / 1024 / 1024
        total = mem_total / 1024 / 1024
    }
    pct = 0
    if (total > 0) pct = used / total * 100
    # full text
    if (percent == "true")
        printf("%s%.1fG/%.1fG (%.0f%%)\n", label, used, total, pct)
    else
        printf("%s%.1fG/%.1fG\n", label, used, total)
    # short text
    printf("%.0f%%\n", pct)
    # color based on usage
    if (pct > 90)
        print "#FF5555"
    else if (pct > 80)
        print "#FFAE00"
    else if (pct > 70)
        print "#FFF600"
    else
        print "#CBA6F7"
}
' /proc/meminfo
